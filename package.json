{
  "name": "letson",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "test:setup": "tsx scripts/business-test-environment.ts setup",
    "dev:business-test": "tsx scripts/business-test-environment.ts start",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy:cloudflare": "wrangler deploy --keep-vars",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --pretty false",
    "production:check": "tsx scripts/production-check.ts",
    "test": "tsx --test tests/*.test.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "cleanup:test": "tsx scripts/cleanup-test-data.ts --confirm",
    "reset:test-data": "tsx scripts/reset-development-data.ts --confirm",
    "create:cashier": "tsx scripts/create-cashier.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.16.0",
    "mongodb": "^7.2.0",
    "mongoose": "^9.6.2",
    "next": "16.4.5",
    "next-auth": "^4.24.14",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "shadcn": "^4.7.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.1",
    "typescript": "^5",
    "wrangler": "4.158.0"
  }
}
