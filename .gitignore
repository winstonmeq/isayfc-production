# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.local-backups/

# next.js
/.next/
/.next-business-test/
/.business-test/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tooling artifacts
type-errors.txt
*.zip

# runtime receipt uploads (move to object storage for serverless deploys)
/public/uploads/
/var/uploads/

# Cloudflare build output, local state and secrets
/.open-next/
/.wrangler/
.dev.vars*
